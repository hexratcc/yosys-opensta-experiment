library (simple) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1, pf);
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  nom_process : 1;
  nom_temperature : 25;
  nom_voltage : 1.0;

  cell (INV) {
    area : 1;
    pin (A) { direction : input; capacitance : 0.01; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values("0.10"); }
        rise_transition (scalar) { values("0.05"); }
        cell_fall (scalar) { values("0.10"); }
        fall_transition (scalar) { values("0.05"); }
      }
    }
  }

  type (bus4) {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell (BUF4) {
    area : 4;
    bus (A) { bus_type : bus4; direction : input; capacitance : 0.01; }
    bus (Y) {
      bus_type : bus4;
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values("0.10"); }
        rise_transition (scalar) { values("0.05"); }
        cell_fall (scalar) { values("0.10"); }
        fall_transition (scalar) { values("0.05"); }
      }
    }
  }

  cell (INV_SLOW) {
    area : 1;
    pin (A) { direction : input; capacitance : 0.01; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values("0.50"); }
        rise_transition (scalar) { values("0.05"); }
        cell_fall (scalar) { values("0.50"); }
        fall_transition (scalar) { values("0.05"); }
      }
    }
  }

  cell (DFF) {
    area : 4;
    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
    }
    pin (CLK) { direction : input; clock : true; capacitance : 0.01; }
    pin (D) {
      direction : input;
      capacitance : 0.01;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (scalar) { values("0.05"); }
        fall_constraint (scalar) { values("0.05"); }
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise (scalar) { values("0.20"); }
        rise_transition (scalar) { values("0.05"); }
        cell_fall (scalar) { values("0.20"); }
        fall_transition (scalar) { values("0.05"); }
      }
    }
  }

  type (bus4a) {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 0;
    bit_to : 3;
  }

  cell (BUF4A) {
    area : 4;
    bus (A) { bus_type : bus4a; direction : input; capacitance : 0.01; }
    bus (Y) {
      bus_type : bus4a;
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        cell_rise (scalar) { values("0.10"); }
        rise_transition (scalar) { values("0.05"); }
        cell_fall (scalar) { values("0.10"); }
        fall_transition (scalar) { values("0.05"); }
      }
    }
  }
}
