current_design network_hier_test
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk -period 10.0000 [get_ports {clk}]
set_input_delay 1.0000 -clock [get_clocks {clk}] -add_delay [get_ports {in1}]
set_false_path\
    -through [get_pins {sub1/and_gate/A1}]
